{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Diagnostic retention result v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "enum": [
        "dry-run",
        "apply"
      ]
    },
    "eligible": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "deleted": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "remaining": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "batchLimit": {
      "const": 500
    },
    "blockers": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "active_or_unresolved",
          "retained_resource",
          "recent_metadata",
          "recovery_evidence"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "at",
    "cutoff",
    "mode",
    "eligible",
    "deleted",
    "remaining",
    "batchLimit",
    "blockers"
  ]
}
