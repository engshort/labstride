{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operational diagnostic event v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "code": {
      "$ref": "#/$defs/code"
    },
    "runId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9_.:-]{1,256}$"
    },
    "operationId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9_.:-]{1,256}$"
    }
  },
  "required": [
    "schemaVersion",
    "at",
    "code",
    "runId",
    "operationId"
  ],
  "$defs": {
    "code": {
      "enum": [
        "agent_default_invalid",
        "agent_default_unsupported",
        "artifact_unavailable",
        "authentication_failed",
        "awaiting_admission",
        "backend_version_mismatch",
        "backup_exists",
        "backup_invalid",
        "broker_configuration_invalid",
        "budget_exhausted",
        "bundle_too_large",
        "cancel_requested",
        "cancelled",
        "catalog_truncated",
        "checkout_not_publishable",
        "ci_page_limit",
        "configuration_invalid",
        "credential_expired",
        "credential_unavailable",
        "diagnostics",
        "effect_blocked",
        "enabled",
        "field_unavailable",
        "forbidden",
        "global_capacity",
        "graphql_errors",
        "history_unavailable",
        "human_takeover",
        "identity_conflict",
        "identity_mismatch",
        "installation_binding_invalid",
        "integrity_mismatch",
        "invalid_cursor",
        "invalid_payload",
        "invalid_provider_data",
        "invalid_transition",
        "issue_closed",
        "issue_conflict",
        "issue_unavailable",
        "maintenance_incomplete",
        "merge_not_enabled",
        "migration_failed",
        "missing_file",
        "none",
        "not_found",
        "observation_unavailable",
        "operation_failed",
        "operator_pause",
        "outcome_unknown",
        "permission_denied",
        "policy_changed",
        "probe_policy_mismatch",
        "projection_blocked",
        "projection_conflict",
        "provider_unavailable",
        "pull_request_changed",
        "pull_request_conflict",
        "pull_request_observation_failed",
        "rate_limited",
        "recovery_required",
        "release_metadata_invalid",
        "release_metadata_unreadable",
        "repair_budget",
        "repeated_failure",
        "report_conflict",
        "resource_busy",
        "restore_destination_occupied",
        "retention_applied",
        "revision_conflict",
        "root_mapping_mismatch",
        "separate_project_credential_required",
        "service_lock_present",
        "service_lock_unavailable",
        "stale_revision",
        "storage_failure",
        "summary_conflict",
        "summary_observation_failed",
        "target_unavailable",
        "tick_failed",
        "transient_unavailable",
        "transport_unknown",
        "unattended_timeout",
        "unsafe_state_path",
        "unsupported_agent_choice",
        "unsupported_capability",
        "unsupported_field_source",
        "unsupported_schema",
        "unsupported_workflow",
        "usage",
        "validation_failed",
        "workflow_blocked"
      ]
    }
  }
}
