{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operational metric snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "queueAgeMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "activeWorkspaces": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "actionCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "actionDurationTotalMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "actionDurationMaxMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "unknownOutcomes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "failedReconciliation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "projectionPending": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "projectionBlocked": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "projectionConflicts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "staleLeases": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "repairAttempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "budgetHolds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cleanupBlockers": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schemaVersion",
    "at",
    "queueAgeMs",
    "activeWorkspaces",
    "actionCount",
    "actionDurationTotalMs",
    "actionDurationMaxMs",
    "unknownOutcomes",
    "failedReconciliation",
    "projectionPending",
    "projectionBlocked",
    "projectionConflicts",
    "staleLeases",
    "repairAttempts",
    "budgetHolds",
    "cleanupBlockers"
  ]
}
